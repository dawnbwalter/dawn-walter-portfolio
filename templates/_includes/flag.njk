{#- Round flag icons for the Languages list. Use: {{ flag("uk") }}. Codes: uk, de, es, it -#}
{%- macro flag(code) -%}
{%- if code == "uk" -%}
<span class="flag"><svg viewBox="15 0 30 30" width="32" height="32" preserveAspectRatio="xMidYMid slice"><rect width="60" height="30" fill="#012169"/><path d="M0,0 L60,30 M60,0 L0,30" stroke="#FFFFFF" stroke-width="6"/><path d="M0,0 L60,30 M60,0 L0,30" stroke="#C8102E" stroke-width="2"/><path d="M30,0 V30 M0,15 H60" stroke="#FFFFFF" stroke-width="10"/><path d="M30,0 V30 M0,15 H60" stroke="#C8102E" stroke-width="6"/></svg></span>
{%- elif code == "de" -%}
<span class="flag"><svg viewBox="0 0 30 30" width="32" height="32"><rect width="30" height="10" fill="#000000"/><rect y="10" width="30" height="10" fill="#DD0000"/><rect y="20" width="30" height="10" fill="#FFCE00"/></svg></span>
{%- elif code == "es" -%}
<span class="flag"><svg viewBox="0 0 30 30" width="32" height="32"><rect width="30" height="7.5" fill="#AA151B"/><rect y="7.5" width="30" height="15" fill="#F1BF00"/><rect y="22.5" width="30" height="7.5" fill="#AA151B"/></svg></span>
{%- elif code == "it" -%}
<span class="flag"><svg viewBox="0 0 30 30" width="32" height="32"><rect width="10" height="30" fill="#009246"/><rect x="10" width="10" height="30" fill="#FFFFFF"/><rect x="20" width="10" height="30" fill="#CE2B37"/></svg></span>
{%- endif -%}
{%- endmacro -%}
